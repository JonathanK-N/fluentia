# =====================================================================
#  Fluentia — variables Railway (modèle, aucune valeur secrète réelle)
#  À saisir dans Railway > service > Variables (« Raw Editor »).
#  Les syntaxes ${{...}} sont des références Railway résolues au déploiement.
#  Noms de services supposés : « Postgres », « api », « web ».
# =====================================================================

# ---------------------------------------------------------------------
#  Service « api »  (Root Directory : /apps/api)
# ---------------------------------------------------------------------
PORT=8000
DATABASE_URL=${{Postgres.DATABASE_URL}}
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=${{RAILWAY_PRIVATE_DOMAIN}},${{RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_WEB_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}   # remplacer par https://app.votre-domaine.com une fois le domaine branché
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fluentia.cognito-inc.ca,https://www.fluentia.cognito-inc.ca
DJANGO_HSTS_SECONDS=0         # passer à 31536000 après validation complète du HTTPS
PRIVATE_MEDIA_ROOT=/var/lib/fluentia/private-media   # point de montage du volume Railway
RUN_MIGRATIONS=1              # migrations au démarrage (une seule réplique)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180

# Correction IA de la Rédaction (« demo » = aucune donnée envoyée à l'extérieur)
WRITING_CORRECTOR=demo        # ou openai
WRITING_CORRECTION_DAILY_LIMIT=10
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low

# Oral avec examinateur IA (« demo » = aucune connexion extérieure ; « openai » = voix en direct)
SPEAKING_PROVIDER=demo        # ou openai (utilise OPENAI_API_KEY)
SPEAKING_DAILY_MINUTES=15     # minutes d'oral par compte sur 24 h glissantes
SPEAKING_REQUIRE_PREMIUM=1   # 0 = oral ouvert à tous les comptes connectés (phase de test), le quota reste actif
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin   # alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe   # 0,003 $/min ; gpt-live-transcribe : 0,017 $/min
SPEAKING_DAILY_BUDGET_USD=5   # plafond de dépense de l'oral, tout le site, sur 24 h ; 0 = pas de plafond

# Courriel de vérification (obligatoire pour l'inscription en production)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Fluentia <no-reply@cognito-inc.ca>
SUPPORT_EMAIL=contact@cognito-inc.ca   # adresse de contact affichée en bas des courriels
EMAIL_TIME_ZONE=America/Toronto        # fuseau des dates écrites dans les courriels
ACCOUNT_ANON_RATE=20/hour
DJANGO_NUM_PROXIES=1         # limite de débit par adresse réelle du visiteur (X-Forwarded-For)

# ---------------------------------------------------------------------
#  Service « web »  (Root Directory : /apps/web)
#  API_ORIGIN est lu PENDANT LA CONSTRUCTION (argument Docker) :
#  toute modification exige un redéploiement du service web.
# ---------------------------------------------------------------------
API_ORIGIN=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
NODE_ENV=production
